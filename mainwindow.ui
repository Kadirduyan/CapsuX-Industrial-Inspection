  <property name="styleSheet">
   <string notr="true">/* Ana Pencere ve Genel Tema */
QMainWindow, QWidget#centralwidget {
    background-color: #0b1320;
    color: #e2e8f0;
    font-family: &quot;Segoe UI&quot;, &quot;Roboto&quot;, sans-serif;
}

/* Ana Paneller */
QFrame#headerFrame,
QFrame#panelLiveVision,
QFrame#panelAiAnalysis,
QFrame#panelCounters,
QFrame#panelHardwareStatus,
QFrame#panelOperatorControls {
    background-color: #142034;
    border: 1px solid #1e3250;
    border-radius: 8px;
}

/* Alt Gruplar */
QFrame#subGroupCamera,
QFrame#subGroupCalibration {
    background-color: #0f192a;
    border: 1px solid #1e3250;
    border-radius: 6px;
}

/* Başlık Etiketleri */
QLabel#lblHeaderTitle {
    color: #f8fafc;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#lblHeaderSubtitle {
    color: #94a3b8;
    font-size: 12px;
}

QLabel#lblSystemStatus {
    color: #22c55e;
    background-color: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.4);
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}

QLabel#lblDateTime {
    color: #cbd5e1;
    background-color: #0f192a;
    border: 1px solid #1e3250;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

/* Panel Başlıkları */
QLabel#lblTitleLiveVision,
QLabel#lblTitleAiAnalysis,
QLabel#lblTitleCounters,
QLabel#lblTitleHardware,
QLabel#lblTitleOperator {
    color: #f1f5f9;
    font-size: 14px;
    font-weight: bold;
}

QLabel#lblSubTitleCamera,
QLabel#lblSubTitleCalibration {
    color: #cbd5e1;
    font-size: 12px;
    font-weight: bold;
}

/* Görüntü Alanları */
QLabel#lblCameraFeed,
QLabel#lblHeatmapFeed {
    background-color: #070c15;
    border: 1px solid #1e3250;
    border-radius: 6px;
    color: #64748b;
}

QLabel#lblCameraStatus {
    color: #38bdf8;
    background-color: #0b1320;
    border: 1px solid #1e3250;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: bold;
}

/* Isı Haritası Uyarı Kutusu */
QFrame#frameAnomalyAlert {
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.45);
    border-radius: 6px;
}

QLabel#lblAnomalyTitle {
    color: #f87171;
    font-size: 13px;
    font-weight: bold;
}

QLabel#lblAnomalyType {
    color: #e2e8f0;
    font-size: 12px;
}

QLabel#lblAnomalyConfidence {
    color: #fca5a5;
    font-size: 12px;
    font-weight: bold;
}

/* Üretim Sayaç Kartları */
QFrame#cardAccepted {
    background-color: rgba(22, 163, 74, 0.14);
    border: 1px solid #16a34a;
    border-radius: 8px;
}

QLabel#lblAcceptedTitle {
    color: #86efac;
    font-size: 13px;
    font-weight: 600;
}

QLabel#lblAcceptedCount {
    color: #4ade80;
    font-size: 28px;
    font-weight: bold;
}

QFrame#cardRejected {
    background-color: rgba(220, 38, 38, 0.14);
    border: 1px solid #dc2626;
    border-radius: 8px;
}

QLabel#lblRejectedTitle {
    color: #fca5a5;
    font-size: 13px;
    font-weight: 600;
}

QLabel#lblRejectedCount {
    color: #f87171;
    font-size: 28px;
    font-weight: bold;
}

QFrame#cardErrorRate {
    background-color: rgba(56, 189, 248, 0.12);
    border: 1px solid #0284c7;
    border-radius: 8px;
}

QLabel#lblErrorRateTitle {
    color: #7dd3fc;
    font-size: 13px;
    font-weight: 600;
}

QLabel#lblErrorRate {
    color: #38bdf8;
    font-size: 28px;
    font-weight: bold;
}

/* ComboBox Tasarımı */
QComboBox {
    background-color: #0b1320;
    border: 1px solid #2b4468;
    border-radius: 5px;
    padding: 4px 10px;
    color: #e2e8f0;
    font-size: 12px;
}

QComboBox:hover {
    border: 1px solid #38bdf8;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #142034;
    border: 1px solid #2b4468;
    selection-background-color: #1e3250;
    color: #e2e8f0;
}

/* Buton Tasarımları */
QPushButton {
    background-color: #1e3250;
    border: 1px solid #2b4468;
    border-radius: 5px;
    color: #f1f5f9;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #29436b;
    border: 1px solid #38bdf8;
}

QPushButton:pressed {
    background-color: #152338;
}

QPushButton#btnConnectSerial {
    background-color: #0284c7;
    border: 1px solid #38bdf8;
    color: #ffffff;
}

QPushButton#btnConnectSerial:hover {
    background-color: #0369a1;
}

QPushButton#btnStart {
    background-color: #16a34a;
    border: 1px solid #22c55e;
    color: #ffffff;
    font-size: 14px;
    padding: 10px 16px;
}

QPushButton#btnStart:hover {
    background-color: #15803d;
}

QPushButton#btnEmergencyStop {
    background-color: #dc2626;
    border: 1px solid #ef4444;
    color: #ffffff;
    font-size: 14px;
    padding: 10px 16px;
}

QPushButton#btnEmergencyStop:hover {
    background-color: #b91c1c;
}

QPushButton#btnResetCounters {
    background-color: #334155;
    border: 1px solid #475569;
    color: #f1f5f9;
    font-size: 14px;
    padding: 10px 16px;
}

QPushButton#btnResetCounters:hover {
    background-color: #475569;
}

QPushButton#btnCalibrate {
    background-color: #2563eb;
    border: 1px solid #3b82f6;
    color: #ffffff;
}

QPushButton#btnCalibrate:hover {
    background-color: #1d4ed8;
}

QPushButton#btnTestAccept {
    background-color: rgba(22, 163, 74, 0.25);
    border: 1px solid #22c55e;
    color: #4ade80;
}

QPushButton#btnTestAccept:hover {
    background-color: rgba(22, 163, 74, 0.45);
}

QPushButton#btnTestReject {
    background-color: rgba(220, 38, 38, 0.25);
    border: 1px solid #ef4444;
    color: #f87171;
}

QPushButton#btnTestReject:hover {
    background-color: rgba(220, 38, 38, 0.45);
}

/* Slider Tasarımı */
QSlider::groove:horizontal {
    border: 1px solid #1e3250;
    height: 6px;
    background: #0b1320;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #0284c7;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #38bdf8;
    border: 1px solid #0284c7;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #7dd3fc;
}
</string>
